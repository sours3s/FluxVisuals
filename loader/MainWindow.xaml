<Window x:Class="FluxVisualsLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FluxVisuals" Width="1120" Height="700" MinWidth="960" MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0B12"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Icon="Resources/FluxVisuals.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <!-- Непрозрачная для мыши полоса поверх WebView: только шапка слева от кнопок.
             Даёт нормальное перетаскивание окна и двойной клик на разворачивание. -->
        <Border x:Name="DragStrip" Height="48" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Margin="0,0,186,0" Background="Transparent" Cursor="SizeAll" Panel.ZIndex="5"
                PreviewMouseLeftButtonDown="DragStrip_PreviewMouseLeftButtonDown" />
    </Grid>
</Window>
