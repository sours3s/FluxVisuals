{
  "schemaVersion": 1,
  "id": "fluxvisuals",
  "version": "${version}",
  "name": "FluxVisuals",
  "description": "FluxVisuals — красивый визуальный клиент для Minecraft (HUD, TargetHUD, ClickGUI, эффекты). Только клиентская отрисовка.",
  "authors": ["FluxVisuals"],
  "license": "MIT",
  "icon": "assets/fluxvisuals/textures/icon/logo.png",
  "environment": "client",
  "entrypoints": {
    "client": ["ru.fluxvisuals.client.FluxVisualsClient"]
  },
  "mixins": ["fluxvisuals.mixins.json"],
  "accessWidener": "fluxvisuals.accesswidener",
  "jars": [
    { "file": "META-INF/jars/figura-0.1.5+1.21.11-fabric-mc.jar" },
    { "file": "META-INF/jars/luaj-core-3.0.8-figura.jar" },
    { "file": "META-INF/jars/luaj-jse-3.0.8-figura.jar" }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
