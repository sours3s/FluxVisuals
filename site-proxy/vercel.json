{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/news",
      "destination": "https://p01--fluxvisuals-bots--7wqqdlfq28t5.code.run/news"
    },
    {
      "source": "/api/news/:path*",
      "destination": "https://p01--fluxvisuals-bots--7wqqdlfq28t5.code.run/api/news/:path*"
    },
    {
      "source": "/bot-status",
      "destination": "https://p01--fluxvisuals-bots--7wqqdlfq28t5.code.run/bot-status"
    },
    {
      "source": "/:path*",
      "destination": "https://p01--fluxvisuals-auth--7wqqdlfq28t5.code.run/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
